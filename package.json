{
  "name": "traceback",
  "version": "1.0.0",
  "description": "TraceBack - a lost & found board that matches lost items with found ones",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:backend": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently -k -n api,web -c blue,magenta \"npm run dev\" \"npm --prefix traceback-client run dev\"",
    "client:install": "npm --prefix traceback-client install",
    "client:build": "npm --prefix traceback-client run build",
    "test": "cross-env NODE_ENV=test jest",
    "test:integration": "cross-env NODE_ENV=test RUN_INTEGRATION=1 jest --runInBand tests/integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pragalbhsh/TraceBack.git"
  },
  "keywords": [
    "lost-and-found",
    "express",
    "mongodb",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Pragalbhsh/TraceBack/issues"
  },
  "homepage": "https://github.com/Pragalbhsh/TraceBack#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "mongodb-memory-server-core": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testTimeout": 30000
  },
  "nodemonConfig": {
    "ignore": [
      "traceback-client/*",
      "uploads/*",
      "tests/*"
    ]
  }
}
