# Copy this file to .env and fill in your values. Never commit .env.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas free tier works great)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/traceback

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server -----------------------------------------------------------------
PORT=3000
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://bejewelled-licorice-d543ef.netlify.app
# Frontend URL used for links in emails
CLIENT_URL=http://localhost:5173
# Set to 1 when hosted behind a proxy (Render, Railway, Heroku...). Defaults to 1 in production.
# TRUST_PROXY=1

# --- Image uploads (optional) -----------------------------------------------
# Without these, images are stored in ./uploads (fine locally, but most hosts wipe the disk on deploy).
CLOUD_NAME=
API_KEY=
API_SECRET=
# MAX_UPLOAD_MB=5

# --- Match alert emails (optional) ------------------------------------------
# Without SMTP_HOST, emails are printed in the server console instead of sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TraceBack <no-reply@example.com>
